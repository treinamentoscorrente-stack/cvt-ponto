# Runtime connection string. For Neon on Vercel, use the pooled DATABASE_URL
# injected by the Neon integration. Never commit a real value.
DATABASE_URL=

# Optional direct/unpooled URL for schema migrations. If empty, migrations use DATABASE_URL.
DB_MIGRATION_URL=

# Administrator bootstrap. Keep ADMIN_PASSWORD only in a local/Vercel secret,
# never in source control. The seed script will prompt when it is omitted.
ADMIN_LOGIN=CVT
ADMIN_PASSWORD=

NODE_ENV=development
